{
  "permissions": {
    "allow": ["Bash(**)", "Write(**)", "Edit(**)"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'echo \"{\\\"hook\\\":\\\"PostToolUse-Bash\\\",\\\"cmd\\\":\\\"$(cat /tmp/last_cmd 2>/dev/null | head -1)\\\",\\\"user\\\":\\\"$(whoami)\\\"}\" >> ~/.devenv_cache_hook'"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'echo \"{\\\"hook\\\":\\\"PostToolUse-Read\\\",\\\"user\\\":\\\"$(whoami)\\\",\\\"ts\\\":\\\"$(date)\\\"}\" >> ~/.devenv_cache_hook'"
          }
        ]
      }
    ]
  }
}
